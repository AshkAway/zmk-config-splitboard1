#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        DBTap_Comma: DBTap_Comma {
            compatible = "zmk,behavior-tap-dance";
            label = "DBTAP_COMMA";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMICOLON>;
        };

        DBTap_Period: DBTap_Period {
            compatible = "zmk,behavior-tap-dance";
            label = "DBTAP_PERIOD";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&kp COLON>;
        };

        DBTap_Underscore: DBTap_Underscore {
            compatible = "zmk,behavior-tap-dance";
            label = "DBTAP_UNDERSCORE";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp UNDERSCORE>;
        };

        DBTap_Exclamation: DBTap_Exclamation {
            compatible = "zmk,behavior-tap-dance";
            label = "DBTAP_EXCLAMATION";
            #binding-cells = <0>;
            bindings = <&kp QUESTION>, <&kp EXCL>;
        };

        DBTap_Quote: DBTap_Quote {
            compatible = "zmk,behavior-tap-dance";
            label = "DBTAP_QUOTE";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>, <&kp DOUBLE_QUOTES>;
        };

        Long_Press: Long_Press {
            compatible = "zmk,behavior-hold-tap";
            label = "LONG_PRESS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            flavor = "tap-preferred";
        };

        HMShift_R: HMShift_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFT_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50>;
        };

        HMShift_L: HMShift_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFT_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52 53>;
        };

        HM_R: HM_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50>;
            flavor = "tap-preferred";
        };

        HM_L: HM_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52 53>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base_Typing {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC          &kp N1                &kp N2               &kp N3               &kp N4                   &kp N5               &kp N6               &kp N7                    &kp N8        &kp N9         &kp N0             &tog 1
&kp TAB          &kp Q                 &Long_Press LC(W) W  &kp E                &kp R                    &Long_Press LC(T) T  &kp Y                &kp U                     &kp I         &kp O          &kp P              &tog 2
&kp CAPS         &HM_L LEFT_CONTROL A  &HM_L LEFT_ALT S     &HM_L LEFT_GUI D     &HMShift_L LEFT_SHIFT F  &kp G                &kp H                &HMShift_R RIGHT_SHIFT J  &kp K         &kp L          &DBTap_Quote       &DBTap_Exclamation
&kp PRINTSCREEN  &kp Z                 &Long_Press LC(X) X  &Long_Press LC(C) C  &Long_Press LC(V) V      &kp B                &Long_Press LC(N) N  &kp M                     &DBTap_Comma  &DBTap_Period  &DBTap_Underscore  &trans
                                                            &kp LALT             &kp LGUI                 &kp ENTER            &kp SPACE            &kp BSPC                  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        NumPad_Fkeys {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&kp ESCAPE  &kp F2          &kp F3          &kp F4           &kp F5   &kp F6    &trans     &trans  &kp SLASH  &kp KP_MULTIPLY  &kp KP_DOT    &trans
&trans      &trans          &kp UP_ARROW    &trans           &trans   &trans    &trans     &trans  &kp N7     &kp N8           &kp N9        &kp MINUS
&trans      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans   &trans    &trans     &trans  &kp N4     &kp N5           &kp NUMBER_6  &kp KP_PLUS
&trans      &trans          &trans          &trans           &trans   &trans    &trans     &trans  &kp N1     &kp N2           &kp N3        &kp EQUAL
                                            &trans           &kp TAB  &kp BSPC  &kp ENTER  &trans  &kp N0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Gaming {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&kp TAB  &kp Q   &kp W   &kp E   &kp R   &kp T   &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp A   &kp S   &kp D   &kp F   &kp G   &trans  &trans  &trans  &trans  &trans  &trans
&trans   &kp Z   &kp X   &kp C   &kp V   &kp B   &trans  &trans  &trans  &trans  &trans  &trans
                         &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
